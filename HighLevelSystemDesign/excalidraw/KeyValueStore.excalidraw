    },
    {
      "id": "IXlUj7LQie0HUXc-MSZN_",
      "type": "text",
      "x": 606.299459015171,
      "y": 5174.204554333086,
      "width": 595.5792236328125,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b4L",
      "roundness": null,
      "seed": 1080786075,
      "version": 122,
      "versionNonce": 51608661,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788642539755,
      "link": null,
      "locked": false,
      "text": "Merge multiple SSTables into fewer, larger, fully-sorted SSTables.",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Merge multiple SSTables into fewer, larger, fully-sorted SSTables.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "Ss0dQ7kSOZX67czHCCujU",
      "type": "text",
      "x": 593.6505312404371,
      "y": 5208.947869879207,
      "width": 490.53936767578125,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b4M",
      "roundness": null,
      "seed": 1804365461,
      "version": 78,
      "versionNonce": 560406843,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788642523037,
      "link": null,
      "locked": false,
      "text": "• Discards overwritten keys (keeps only latest version)",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "• Discards overwritten keys (keeps only latest version)",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "qy5mfs-LfO1ZvvxWD58oZ",
      "type": "text",
      "x": 594.5590088790736,
      "y": 5236.588485961958,
      "width": 596.7592163085938,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b4N",
      "roundness": null,
      "seed": 883372347,
      "version": 132,
      "versionNonce": 1379696629,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788642542471,
      "link": null,
      "locked": false,
      "text": "• Discards tombstones past their grace period (completes deletes)",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "• Discards tombstones past their grace period (completes deletes)",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "4-emOsrae5sko5Rr2gIK3",
      "type": "text",
      "x": 595.2580936269901,
      "y": 5264.434372871054,
      "width": 435.5394287109375,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b4O",
      "roundness": null,
      "seed": 831247349,
      "version": 157,
      "versionNonce": 2032618997,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788642545991,
      "link": null,
      "locked": false,
      "text": "• Reduces the number of files a read must check",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "• Reduces the number of files a read must check",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "NxfipQm8VTjDX_z4WRqsR",
      "type": "text",
      "x": 549.0758907778583,
      "y": 5306.875390227943,
      "width": 1032.5917320371536,
      "height": 25,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b4P",
      "roundness": null,
      "seed": 39955797,
      "version": 118,
      "versionNonce": 931770293,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788642691868,
      "link": null,
      "locked": false,
      "text": "Bloom filter is used here to avoid unnecessary disk seeks on reads for keys that don't exist in a given SSTable.",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Bloom filter is used here to avoid unnecessary disk seeks on reads for keys that don't exist in a given SSTable.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "Ulhfu0Egycgr_a5Sr6q-L",
      "type": "text",
      "x": 592.2742382400776,
      "y": 5331.816569705477,
      "width": 743.9788818359375,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b4Q",
      "roundness": null,
      "seed": 2076346203,
      "version": 41,
      "versionNonce": 286876187,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788642742400,
      "link": null,
      "locked": false,
      "text": "A Bloom filter is a probabilistic data structure used to test whether an element is a\nmember of a set. It trades a small, tunable chance of false positives for massive\nsavings in space and O(1)-ish time — and it never produces a false negative.",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A Bloom filter is a probabilistic data structure used to test whether an element is a member of a set. It trades a small, tunable chance of false positives for massive savings in space and O(1)-ish time — and it never produces a false negative.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "PA_xMnOYbiD45jB9hSIGe",
      "type": "text",
      "x": 592.7624174828644,
      "y": 5411.683759531258,
      "width": 746.718994140625,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b4R",
      "roundness": null,
      "seed": 2098229205,
      "version": 85,
      "versionNonce": 133706747,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788642744832,
      "link": null,
      "locked": false,
      "text": "One-line definition: \"Is this element definitely not in the set, or possibly in the set?\"\n— that's the only question a Bloom filter answers.",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "One-line definition: \"Is this element definitely not in the set, or possibly in the set?\" — that's the only question a Bloom filter answers.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "meAWOwIGynW-DemfOdrRp",
      "type": "text",
      "x": 514.0969883710161,
      "y": 5744.278134960397,
      "width": 952.7248546459025,
      "height": 75,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b4S",
      "roundness": null,
      "seed": 544136731,
      "version": 268,
      "versionNonce": 1530121243,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788643374759,
      "link": null,
      "locked": false,
      "text": "Read repair only fixes divergence on keys someone actually reads. Cold data can silently diverge between\nreplicas after a missed write (e.g., during a partition) and stay diverged forever without a background\nprocess to catch it.",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Read repair only fixes divergence on keys someone actually reads. Cold data can silently diverge between replicas after a missed write (e.g., during a partition) and stay diverged forever without a background process to catch it.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "QlejP7aXsZcvua9AycYwW",
      "type": "text",
      "x": 555.6674171166798,
      "y": 5826.0020557374455,
      "width": 312.59967041015625,
      "height": 25,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b4T",
      "roundness": null,
      "seed": 1630647227,
      "version": 270,
      "versionNonce": 12161211,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788643374759,
      "link": null,
      "locked": false,
      "text": "Comparison between two replicas:",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Comparison between two replicas:",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "KWyr0pxpnptTPX-YyDB4P",
      "type": "text",
      "x": 579.6755970341932,
      "y": 5861.828510615853,
      "width": 549.5993041992188,
      "height": 25,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b4U",
      "roundness": null,
      "seed": 1254144373,
      "version": 254,
      "versionNonce": 1180549467,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788643374760,
      "link": null,
      "locked": false,
      "text": "1. Exchange root hashes → different? → recurse into children",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Exchange root hashes → different? → recurse into children",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "Lbl7zBHLAXyFjAbJelWbD",
      "type": "text",
      "x": 580.5297016110117,
      "y": 5889.226748168804,
      "width": 568.6592407226562,
      "height": 25,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b4V",
      "roundness": null,
      "seed": 1238991963,
      "version": 291,
      "versionNonce": 1970462203,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788643374760,
      "link": null,
      "locked": false,
      "text": "2. At each level, only recurse into subtrees whose hashes differ",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "2. At each level, only recurse into subtrees whose hashes differ",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "OmdVaicSGv4PGTJZ2K5-j",
      "type": "text",
      "x": 581.8108372354775,
      "y": 5915.076547579095,
      "width": 616.4992065429688,
      "height": 25,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b4W",
      "roundness": null,
      "seed": 2108932821,
      "version": 291,
      "versionNonce": 150693531,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788643374760,
      "link": null,
      "locked": false,
      "text": "3. Leaves that differ identify the exact key ranges that have diverged",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "3. Leaves that differ identify the exact key ranges that have diverged",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "VO9paGck2kVUMWtIlQ_AN",
      "type": "text",
      "x": 582.6319090926943,
      "y": 5942.890424297913,
      "width": 574.3193359375,
      "height": 25,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b4X",
      "roundness": null,
      "seed": 981352699,
      "version": 267,
      "versionNonce": 2007620411,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788643374760,
      "link": null,
      "locked": false,
      "text": "4. Stream only THOSE key ranges between replicas to reconcile",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "4. Stream only THOSE key ranges between replicas to reconcile",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "7SJ_UYCcmAXItiCkDorRz",
      "type": "text",
      "x": 561.4057191656024,
      "y": 5978.547710652818,
      "width": 483.7593994140625,
      "height": 25,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b4Y",
      "roundness": null,
      "seed": 1681825845,
      "version": 258,
      "versionNonce": 1038138331,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788643374760,
      "link": null,
      "locked": false,
      "text": "Cost: O(log n) hash comparisons to locate divergence,",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Cost: O(log n) hash comparisons to locate divergence,",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "JF07FZGaD2oQLLzs5Vrqf",
      "type": "text",
      "x": 563.0070369784473,
      "y": 6010.563815539943,
      "width": 574.21923828125,
      "height": 25,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b4Z",
      "roundness": null,
      "seed": 2091018651,
      "version": 234,
      "versionNonce": 666011771,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788643374760,
      "link": null,
      "locked": false,
      "text": "instead of O(n) — comparing every single key between replicas.",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "instead of O(n) — comparing every single key between replicas.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "JNP5PdKusQB2pJ6JOpBV-",
      "type": "text",
      "x": 517.7324128635985,
      "y": 6044.839954229062,
      "width": 960.3563935935697,
      "height": 75,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b4a",
      "roundness": null,
      "seed": 1539061883,
      "version": 246,
      "versionNonce": 1524744475,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788643374760,
      "link": null,
      "locked": false,
      "text": "This runs as a low-priority background process (often scheduled during off-peak hours, rate-limited to\navoid competing with foreground traffic) and is the safety net that guarantees eventual consistency even\nfor data nobody happens to read.",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "This runs as a low-priority background process (often scheduled during off-peak hours, rate-limited to avoid competing with foreground traffic) and is the safety net that guarantees eventual consistency even for data nobody happens to read.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "n87PEIt0plUr_8j576tDw",
      "type": "text",
      "x": 553.7801278310528,
      "y": 5582.187356411989,
      "width": 369.9395751953125,
      "height": 25,
