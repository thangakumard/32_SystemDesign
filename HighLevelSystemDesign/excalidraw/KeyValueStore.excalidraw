    {
      "id": "tQXKZKH7QpfBEg63KFOBs",
      "type": "text",
      "x": 654.6077768688066,
      "y": 6161.185732309651,
      "width": 451.8392028808594,
      "height": 25,
      "angle": 0,
      "strokeColor": "#e03131",
