      "frameId": null,
      "index": "b1y",
      "roundness": null,
      "seed": 188289147,
      "version": 4,
      "versionNonce": 963733717,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1788635643954,
      "link": null,
      "locked": false,
      "text": "Write path (per node):\n  Write ──▶ WAL (append-only, durability)\n        └─▶ Memtable (in-memory sorted structure, e.g. skip list / red-black tree)\n\n  Memtable fills (e.g. 128–256 MB) ──▶ flush to disk as an immutable SSTable\n                                        (Sorted String Table: sorted key→value\n                                         pairs, written once, never mutated)",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Write path (per node):\n  Write ──▶ WAL (append-only, durability)\n        └─▶ Memtable (in-memory sorted structure, e.g. skip list / red-black tree)\n\n  Memtable fills (e.g. 128–256 MB) ──▶ flush to disk as an immutable SSTable\n                                        (Sorted String Table: sorted key→value\n                                         pairs, written once, never mutated)",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
