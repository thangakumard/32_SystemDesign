      "isDeleted": true,
      "boundElements": null,
      "updated": 1788642498046,
      "link": null,
      "locked": false,
      "text": "pairs, written once, never mutated)",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "pairs, written once, never mutated)",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "D9vk7OBq18HWw3EtFdj68",
      "type": "text",
      "x": 550.4225376307138,
      "y": 5031.267349910798,
      "width": 989.6598751707664,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b4J",
      "roundness": null,
      "seed": 1248076789,
      "version": 123,
      "versionNonce": 1603397307,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788642510134,
      "link": null,
      "locked": false,
      "text": "Durability note: the memtable is volatile (RAM only) — it has no crash-survival value on its own. The WAL is\nthe sole durability boundary: it's an append-only disk write (often fsync'd), so it's slower than the in-memory\nmemtable write, but it's what makes the memtable's loss on crash a non-issue — replay reconstructs it. This\nis why WAL append is sequenced before the memtable apply in the write path (Section 9).",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Durability note: the memtable is volatile (RAM only) — it has no crash-survival value on its own. The WAL is the sole durability boundary: it's an append-only disk write (often fsync'd), so it's slower than the in-memory memtable write, but it's what makes the memtable's loss on crash a non-issue — replay reconstructs it. This is why WAL append is sequenced before the memtable apply in the write path (Section 9).",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "l0vTT4uSy__Ujt2l7Vfnn",
      "type": "text",
      "x": 550.5788713704678,
      "y": 5142.357722511238,
      "width": 250.23980712890625,
      "height": 25,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
