    {
      "id": "dNhyWXGuYtM4Ucva8Nj_y",
      "type": "text",
      "x": 550.5644604146237,
      "y": 4942.235946012824,
      "width": 1034.7837999975318,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b4C",
