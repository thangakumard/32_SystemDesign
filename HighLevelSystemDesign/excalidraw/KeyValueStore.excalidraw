    {
      "id": "9bLu58Rpc2txrQKtF4zyZ",
      "type": "text",
      "x": 617.511474609375,
      "y": 894.7461547851562,
      "width": 747.8473510742186,
      "height": 200,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
