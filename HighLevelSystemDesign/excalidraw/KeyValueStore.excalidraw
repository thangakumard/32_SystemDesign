      "boundElements": null,
      "updated": 1788643495383,
      "link": null,
      "locked": false,
      "text": "Sloppy-quorum write \"lost\" hints        Node holding a hint crashes before replaying\nit        Hint count/age metrics per node        Replicate hints themselves with a small\nreplication factor, or bound hint TTL and rely on anti-entropy as the final backstop",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Sloppy-quorum write \"lost\" hints        Node holding a hint crashes before replaying it        Hint count/age metrics per node        Replicate hints themselves with a small replication factor, or bound hint TTL and rely on anti-entropy as the final backstop",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
