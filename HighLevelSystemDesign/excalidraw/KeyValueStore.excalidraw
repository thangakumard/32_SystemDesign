      "boundElements": null,
      "updated": 1788638080569,
      "link": null,
      "locked": false,
      "text": "→ Client (or app logic) merges: [\"shoes\",\"socks\",\"hat\",\"gloves\"]",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "→ Client (or app logic) merges: [\"shoes\",\"socks\",\"hat\",\"gloves\"]",
