      "labelPosition": null
    },
    {
      "id": "fwNfB-poVbHKRf_4MUNzQ",
      "type": "text",
      "x": 287.41309689993636,
      "y": 3689.5341082399073,
      "width": 611.6592407226562,
      "height": 25,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2y",
      "roundness": null,
      "seed": 325297717,
      "version": 3,
