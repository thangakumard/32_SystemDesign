    },
    {
      "id": "L8p8J-aDRgxj6iT99YzOK",
      "type": "text",
      "x": 653.1811593456656,
      "y": 5236.012465429383,
      "width": 313.9395751953125,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
