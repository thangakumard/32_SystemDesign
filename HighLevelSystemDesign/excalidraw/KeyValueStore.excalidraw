    {
      "id": "MQoWx05mrX3VoOeT8V9jF",
      "type": "text",
      "x": 631.455119230046,
      "y": 3550.796070316466,
      "width": 949.9532206566354,
      "height": 95.04990909597105,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b34",
      "roundness": null,
      "seed": 1997571605,
      "version": 187,
      "versionNonce": 1098989371,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788638372522,
      "link": null,
      "locked": false,
      "text": "For specific data shapes — counters, sets, registers — use a data structure whose merge function is\nmathematically guaranteed to converge regardless of write order (commutative, associative, idempotent\nmerge). A G-Counter (grow-only counter) merges by taking the per-node max; an OR-Set merges by union\nwith tombstones for removes.",
      "fontSize": 19.00998181919421,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "For specific data shapes — counters, sets, registers — use a data structure whose merge function is mathematically guaranteed to converge regardless of write order (commutative, associative, idempotent merge). A G-Counter (grow-only counter) merges by taking the per-node max; an OR-Set merges by union with tombstones for removes.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
