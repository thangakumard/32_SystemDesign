      "seed": 458630203,
      "version": 72,
      "versionNonce": 2143642613,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788642448572,
      "link": null,
      "locked": false,
      "text": "Each node needs a local storage engine optimized for the write-heavy, append-friendly pattern this architecture\nproduces. The Log-Structured Merge Tree (LSM-tree) is the standard choice (used by Cassandra, RocksDB,\nLevelDB, HBase).",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Each node needs a local storage engine optimized for the write-heavy, append-friendly pattern this architecture produces. The Log-Structured Merge Tree (LSM-tree) is the standard choice (used by Cassandra, RocksDB, LevelDB, HBase).",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "c_sqCsiN8Sp5_nOyIbVvc",
