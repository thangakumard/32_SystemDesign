      "isDeleted": true,
      "boundElements": null,
      "updated": 1788642498046,
      "link": null,
      "locked": false,
      "text": "└─▶ Memtable (in-memory sorted structure, e.g. skip list / red-black tree)",
      "fontSize": 20,
