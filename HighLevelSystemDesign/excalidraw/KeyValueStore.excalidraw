      "versionNonce": 1096401781,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788622925344,
      "link": null,
      "locked": false,
      "text": "\n1. put(key, value) - write or overwrite\n2. get(key) - get the current value of the key. Return multiple sibling versions on conflicts \n3. delete(key)  - Delete via tombstone\n4. Versioning - Support causality tracking ",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\n1. put(key, value) - write or overwrite\n2. get(key) - get the current value of the key. Return multiple sibling versions on conflicts \n3. delete(key)  - Delete via tombstone\n4. Versioning - Support causality tracking ",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
