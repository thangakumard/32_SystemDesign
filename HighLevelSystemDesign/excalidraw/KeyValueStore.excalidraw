      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0a",
      "roundness": null,
      "seed": 1139866485,
      "version": 806,
      "versionNonce": 751643323,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788624312696,
      "link": null,
      "locked": false,
      "text": "Key = 500 million\nAvg Value: 1 KB\nReplication factor: N = 3\nRead : write === 80% : 20%\nPeak OPS: 250,000 ops / Sec ===> 200,000 reads/Sec + 50,000 writes/sec\n\n500,000,000 * 1.2 kb = 600 GB ( Single Copy)\nwith Replication Factor 3 = 600 * 3 = 1.8 TB across a cluster\n\n50,000 writes/sec * 3 = 150,000 w/ sec\n\nif R = 1 200,000 r/sec\nif R = 2 = 400,000 r/sec\n\nTotal Cluster ops/sec\nif R = 1 ==> 150,000 + 200,000 = 350,000 ops/sec\nif R = 2 ==> 150,000 + 400,000 = 550,000 ops/sec\n\nPer node capacity ~ 10K ops/sec\n\n550,000 / 10,000 = 55 nodes + 50 % head room ~ 80 nodes per cluster",
      "fontSize": 15.965228515625014,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Key = 500 million\nAvg Value: 1 KB\nReplication factor: N = 3\nRead : write === 80% : 20%\nPeak OPS: 250,000 ops / Sec ===> 200,000 reads/Sec + 50,000 writes/sec\n\n500,000,000 * 1.2 kb = 600 GB ( Single Copy)\nwith Replication Factor 3 = 600 * 3 = 1.8 TB across a cluster\n\n50,000 writes/sec * 3 = 150,000 w/ sec\n\nif R = 1 200,000 r/sec\nif R = 2 = 400,000 r/sec\n\nTotal Cluster ops/sec\nif R = 1 ==> 150,000 + 200,000 = 350,000 ops/sec\nif R = 2 ==> 150,000 + 400,000 = 550,000 ops/sec\n\nPer node capacity ~ 10K ops/sec\n\n550,000 / 10,000 = 55 nodes + 50 % head room ~ 80 nodes per cluster",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
