      "isDeleted": false,
      "boundElements": null,
      "updated": 1788651971493,
      "link": null,
      "locked": false,
      "text": "Cons:\n- IDs are 128 bits long, but our requirement is 64 bits.\n- Don't grow over time\n.- IDs could be non-numeric.\n\n",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Cons:\n- IDs are 128 bits long, but our requirement is 64 bits.\n- Don't grow over time\n.- IDs could be non-numeric.\n\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
