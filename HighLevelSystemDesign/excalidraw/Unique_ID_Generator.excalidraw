    },
    {
      "id": "mbVwsTIeAL1AkgKHw5l8g",
      "type": "text",
      "x": 322.5870760021229,
      "y": -1218.954245919629,
      "width": 785.149285301482,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b4e",
      "roundness": null,
      "seed": 559449991,
      "version": 267,
      "versionNonce": 1674014089,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788646484790,
      "link": null,
      "locked": false,
      "text": "1. Generate Unique ID => should be globally unique\n2. IDs should be sortable by generation time (Enable range scan)\n3. Support high-throughput generation\n4. No single point failure\n5. ID should fit in 64 bits",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Generate Unique ID => should be globally unique\n2. IDs should be sortable by generation time (Enable range scan)\n3. Support high-throughput generation\n4. No single point failure\n5. ID should fit in 64 bits",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
