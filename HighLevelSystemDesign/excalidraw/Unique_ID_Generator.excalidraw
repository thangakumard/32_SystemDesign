      "labelPosition": null
    },
    {
      "id": "FLbH0uxjB3FHwWG0Qk9_9",
      "type": "text",
      "x": 399.24463021829996,
      "y": 540.4988818166106,
      "width": 1112.9385986328125,
      "height": 250,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b5I",
      "roundness": null,
      "seed": 345149929,
      "version": 13,
      "versionNonce": 1700079881,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788656748799,
      "link": null,
      "locked": false,
      "text": "Flickr's Ticket Server is a dedicated MySQL-based global ID generator. \nFlickr had sharded MySQL databases, so normal AUTO_INCREMENT couldn't guarantee globally unique IDs across shards. \nThey created a tiny Tickets64 table with a BIGINT AUTO_INCREMENT column and a unique stub. \nTo get an ID, the application executes REPLACE INTO on the stub and retrieves LAST_INSERT_ID().\n\nTo avoid making the Ticket Server a single point of failure, Flickr used two Ticket Servers. \nOne generated odd IDs using auto_increment_increment=2 and offset=1, \nwhile the other generated even IDs using increment=2 and offset=2. \nRequests were round-robin'd between them. If one server went down, \nthe other could continue generating IDs without collisions, although there would be gaps in the sequence.",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Flickr's Ticket Server is a dedicated MySQL-based global ID generator. \nFlickr had sharded MySQL databases, so normal AUTO_INCREMENT couldn't guarantee globally unique IDs across shards. \nThey created a tiny Tickets64 table with a BIGINT AUTO_INCREMENT column and a unique stub. \nTo get an ID, the application executes REPLACE INTO on the stub and retrieves LAST_INSERT_ID().\n\nTo avoid making the Ticket Server a single point of failure, Flickr used two Ticket Servers. \nOne generated odd IDs using auto_increment_increment=2 and offset=1, \nwhile the other generated even IDs using increment=2 and offset=2. \nRequests were round-robin'd between them. If one server went down, \nthe other could continue generating IDs without collisions, although there would be gaps in the sequence.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
