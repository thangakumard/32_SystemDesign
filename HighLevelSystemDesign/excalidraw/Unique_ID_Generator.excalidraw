    {
      "id": "aNjoDUPrKTVIQ2znX97iJ",
      "type": "text",
      "x": 734.21329313655,
      "y": 3794.993344057148,
      "width": 206.15975952148438,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
