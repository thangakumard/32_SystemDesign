    },
    {
      "id": "O_9Q22OZUtxct8ZTFTLIK",
      "type": "text",
      "x": 306.9305301788532,
      "y": -962.2536225098605,
      "width": 248.6605224609375,
      "height": 20.52133491401348,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
