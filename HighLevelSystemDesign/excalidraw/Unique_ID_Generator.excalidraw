    {
      "id": "zKOX5zCggeaEACdWeAZTr",
      "type": "text",
      "x": 628.2446544653609,
      "y": 4763.079721070224,
      "width": 186.05975341796875,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b4B",
      "roundness": null,
      "seed": 1649880789,
      "version": 26,
      "versionNonce": 1737768713,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1788653863534,
      "link": null,
      "locked": false,
      "text": "Smillar to write path",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Smillar to write path",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "dNhyWXGuYtM4Ucva8Nj_y",
      "type": "text",
      "x": 550.5644604146237,
      "y": 4942.235946012824,
      "width": 1034.7837999975318,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b4C",
      "roundness": null,
      "seed": 458630203,
      "version": 73,
      "versionNonce": 974770695,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1788653863534,
      "link": null,
      "locked": false,
      "text": "Each node needs a local storage engine optimized for the write-heavy, append-friendly pattern this architecture\nproduces. The Log-Structured Merge Tree (LSM-tree) is the standard choice (used by Cassandra, RocksDB,\nLevelDB, HBase).",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Each node needs a local storage engine optimized for the write-heavy, append-friendly pattern this architecture produces. The Log-Structured Merge Tree (LSM-tree) is the standard choice (used by Cassandra, RocksDB, LevelDB, HBase).",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "D9vk7OBq18HWw3EtFdj68",
      "type": "text",
      "x": 550.4225376307138,
      "y": 5031.267349910798,
      "width": 989.6598751707664,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b4J",
      "roundness": null,
      "seed": 1248076789,
      "version": 124,
      "versionNonce": 1789490665,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1788653863534,
      "link": null,
      "locked": false,
      "text": "Durability note: the memtable is volatile (RAM only) — it has no crash-survival value on its own. The WAL is\nthe sole durability boundary: it's an append-only disk write (often fsync'd), so it's slower than the in-memory\nmemtable write, but it's what makes the memtable's loss on crash a non-issue — replay reconstructs it. This\nis why WAL append is sequenced before the memtable apply in the write path (Section 9).",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Durability note: the memtable is volatile (RAM only) — it has no crash-survival value on its own. The WAL is the sole durability boundary: it's an append-only disk write (often fsync'd), so it's slower than the in-memory memtable write, but it's what makes the memtable's loss on crash a non-issue — replay reconstructs it. This is why WAL append is sequenced before the memtable apply in the write path (Section 9).",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "l0vTT4uSy__Ujt2l7Vfnn",
      "type": "text",
