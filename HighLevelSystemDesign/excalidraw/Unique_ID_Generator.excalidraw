      "isDeleted": false,
      "boundElements": null,
      "updated": 1788647292467,
      "link": null,
      "locked": false,
      "text": "Five families worth knowing cold:",
      "fontSize": 16.417067931210784,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Five families worth knowing cold:",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "sQ4hU08RUHkaf5oKCQL3r",
      "type": "text",
      "x": 358.9210235010548,
      "y": -916.7287189361297,
      "width": 374.04766845703125,
      "height": 20,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b4j",
      "roundness": null,
      "seed": 448756329,
      "version": 73,
      "versionNonce": 2036876135,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788647234995,
      "link": null,
      "locked": false,
      "text": "1. UUID — zero coordination, no ordering guarantee",
