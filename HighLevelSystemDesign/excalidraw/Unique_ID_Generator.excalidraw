      "text": "3. Ticket Server (Flickr-style)",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "3. Ticket Server (Flickr-style)",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "E6i4HPzfPte5FMqSTy4xO",
      "type": "text",
      "x": 453.5657038697592,
      "y": 555.0042666532562,
      "width": 5.2199859619140625,
      "height": 25,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b5H",
      "roundness": null,
      "seed": 1430942759,
      "version": 5,
      "versionNonce": 1440349127,
      "isDeleted": true,
      "boundElements": null,
