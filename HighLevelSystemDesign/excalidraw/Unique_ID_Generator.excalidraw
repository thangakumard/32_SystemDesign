      "seed": 1634621531,
      "version": 8,
      "versionNonce": 160412585,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1788653844596,
      "link": null,
      "locked": false,
      "text": "hash(key), walk ring →\n preference list\n (if not already on it) \ngenerate/increment \nvector clock",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
