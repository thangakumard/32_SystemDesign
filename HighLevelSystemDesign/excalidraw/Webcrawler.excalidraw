    },
    {
      "id": "JMMoedzQLcW9N81pvLbwO",
      "type": "text",
      "x": 553.0169599004341,
      "y": 2573.734387002589,
      "width": 754.9592895507812,
      "height": 40,
      "angle": 0,
      "strokeColor": "#846358",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b15",
      "roundness": null,
      "seed": 33850461,
      "version": 87,
      "versionNonce": 1547635635,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788675402102,
      "link": null,
      "locked": false,
      "text": "If seeds are English-centric and US-biased, your frontier fills with English-language content before it can\ndiscover the Arabic, Chinese, or Spanish web. This is a structural bias that compounds over time.",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "If seeds are English-centric and US-biased, your frontier fills with English-language content before it can discover the Arabic, Chinese, or Spanish web. This is a structural bias that compounds over time.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
