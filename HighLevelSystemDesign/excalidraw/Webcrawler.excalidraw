      "boundElements": null,
      "updated": 1788709244900,
      "link": null,
      "locked": false,
      "text": "At 11,574 fetches/second, if every fetch triggers a DNS lookup:\n        Each DNS lookup takes 10–100ms\n        DNS resolvers have rate limits and query quotas\n        DNS failures stall fetchers and reduce throughput",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "At 11,574 fetches/second, if every fetch triggers a DNS lookup:\n        Each DNS lookup takes 10–100ms\n        DNS resolvers have rate limits and query quotas\n        DNS failures stall fetchers and reduce throughput",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
