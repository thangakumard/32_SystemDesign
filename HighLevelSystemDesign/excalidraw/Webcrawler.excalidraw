      "boundElements": null,
      "updated": 1788709353561,
      "link": null,
      "locked": false,
      "text": "Implement the Happy Eyeballs algorithm\n     Initiate IPv6 connection\nIf no response within 250ms, simultaneously initiate IPv4 connection\nUse whichever responds first\nCache the winning address family per domain\n\n\n",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Implement the Happy Eyeballs algorithm\n     Initiate IPv6 connection\nIf no response within 250ms, simultaneously initiate IPv4 connection\nUse whichever responds first\nCache the winning address family per domain\n\n\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
