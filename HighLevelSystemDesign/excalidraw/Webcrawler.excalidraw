      "text": "URLs are scored on arrival and bucketed into priority queues. Scoring inputs:",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "URLs are scored on arrival and bucketed into priority queues. Scoring inputs:",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "IQ7vtSQXtMqkOxXdM2_Ju",
      "type": "text",
      "x": 526.0790553368167,
      "y": 2932.653044538207,
      "width": 796.0453301511478,
      "height": 20,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1I",
      "roundness": null,
      "seed": 1224649597,
      "version": 107,
      "versionNonce": 1366178995,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788703959586,
      "link": null,
      "locked": false,
      "text": "Weighted round-robin between queues: P1 picked 3× more often than P2; P2 picked 3× more often than P3.",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Weighted round-robin between queues: P1 picked 3× more often than P2; P2 picked 3× more often than P3.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
