      "isDeleted": false,
      "boundElements": null,
      "updated": 1788708095198,
      "link": null,
      "locked": false,
      "text": "Near-duplicate threshold:\n      Hamming distance ≤ 3 → pages are near-duplicates\n      (Hamming distance = number of differing bits in 64-bit hashes)",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Near-duplicate threshold:\n      Hamming distance ≤ 3 → pages are near-duplicates\n      (Hamming distance = number of differing bits in 64-bit hashes)",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
