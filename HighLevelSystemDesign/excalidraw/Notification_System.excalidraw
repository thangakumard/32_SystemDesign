      "isDeleted": false,
      "boundElements": null,
      "updated": 1788728989207,
      "link": null,
      "locked": false,
      "text": "Event occurs → immediately enqueue one message per recipient.\nGood for: normal-scale events (1 order → 1 recipient; 1 friend\nrequest → 1 recipient). Low latency, simple.",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Event occurs → immediately enqueue one message per recipient.\nGood for: normal-scale events (1 order → 1 recipient; 1 friend\nrequest → 1 recipient). Low latency, simple.",
      "autoResize": true,
