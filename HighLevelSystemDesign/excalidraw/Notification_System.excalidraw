    },
    {
      "id": "KSslj3QyNQyefO2LquNk6",
      "type": "text",
      "x": 3166.570176409524,
      "y": -2339.056172440004,
      "width": 538.4955444335938,
      "height": 140,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b6S",
      "roundness": null,
      "seed": 347096995,
      "version": 358,
      "versionNonce": 1234957517,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788714711650,
      "link": null,
      "locked": false,
      "text": "1. Accept notifications from internal producer services\n2. Should able to send push (ios, Android), email, SMS, in-app notifications\n3. Respect user preferences (email / sms)\n4. Track delivery status\n5. Delivery reliability => At-least-once (No duplicates)\n6. Template rendering\n7. Schedulable",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Accept notifications from internal producer services\n2. Should able to send push (ios, Android), email, SMS, in-app notifications\n3. Respect user preferences (email / sms)\n4. Track delivery status\n5. Delivery reliability => At-least-once (No duplicates)\n6. Template rendering\n7. Schedulable",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "TWTvso5Z9MSMhUf_FGZKh",
