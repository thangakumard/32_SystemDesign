    {
      "id": "j3bhaXLGowyDhFzvD4zle",
      "type": "text",
      "x": 343.4584874300211,
      "y": -1075.374620288925,
      "width": 434.3836364746094,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b4h",
      "roundness": null,
      "seed": 590726697,
      "version": 164,
      "versionNonce": 589471843,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1788712852684,
      "link": null,
      "locked": false,
      "text": "Availability => should available even in network partitioning\nLatency => P99 < 10 ms\nScale => 100K IDs / Sec\nUniqueness => Zero Collusion\n",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Availability => should available even in network partitioning\nLatency => P99 < 10 ms\nScale => 100K IDs / Sec\nUniqueness => Zero Collusion\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "O_9Q22OZUtxct8ZTFTLIK",
      "type": "text",
      "x": 306.9305301788532,
      "y": -962.2536225098605,
      "width": 248.6605224609375,
      "height": 20.52133491401348,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b4i",
      "roundness": null,
      "seed": 533338633,
      "version": 67,
      "versionNonce": 236997453,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1788712852684,
      "link": null,
      "locked": false,
      "text": "Five families worth knowing cold:",
      "fontSize": 16.417067931210784,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Five families worth knowing cold:",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "sQ4hU08RUHkaf5oKCQL3r",
      "type": "text",
      "x": 358.9210235010548,
      "y": -916.7287189361297,
      "width": 374.04766845703125,
      "height": 20,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b4j",
      "roundness": null,
      "seed": 448756329,
      "version": 74,
      "versionNonce": 458660867,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1788712852684,
      "link": null,
      "locked": false,
      "text": "1. UUID — zero coordination, no ordering guarantee",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. UUID — zero coordination, no ordering guarantee",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "9b3j9aMifEuEZOH6lWphZ",
      "type": "text",
      "x": 357.5639799324591,
      "y": -892.2906539325926,
      "width": 668.5274047851562,
      "height": 20,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b4k",
      "roundness": null,
      "seed": 249199783,
      "version": 92,
      "versionNonce": 1609783725,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1788712852684,
      "link": null,
      "locked": false,
      "text": "2. DB auto-increment (single master or multi-master) — strong ordering, coordination-heavy",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "2. DB auto-increment (single master or multi-master) — strong ordering, coordination-heavy",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "zvRrSdkO2Pm33-1tefqsN",
      "type": "text",
      "x": 357.2289667764179,
      "y": -865.0370624839586,
      "width": 682.015380859375,
      "height": 20,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b4l",
      "roundness": null,
      "seed": 1066812745,
      "version": 66,
      "versionNonce": 1321870243,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1788712852684,
      "link": null,
      "locked": false,
      "text": "3. Ticket server (Flickr) — offloads coordination to a dedicated, horizontally-partitioned DB tier",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "3. Ticket server (Flickr) — offloads coordination to a dedicated, horizontally-partitioned DB tier",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "rEEMLl6-sTLSqWMn5Nq7Y",
      "type": "text",
      "x": 355.16607446191006,
      "y": -838.9422508857305,
      "width": 683.6154174804688,
      "height": 20,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b4m",
      "roundness": null,
      "seed": 1607618503,
      "version": 99,
      "versionNonce": 1964350477,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1788712852684,
      "link": null,
      "locked": false,
      "text": "4. Snowflake (Twitter) — coordination happens once at worker-ID assignment, not per-request",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "4. Snowflake (Twitter) — coordination happens once at worker-ID assignment, not per-request",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "_djxM-iu3-Og38mH2U1Vt",
      "type": "text",
      "x": 354.40338541661066,
      "y": -813.5437103707992,
      "width": 713.6793823242188,
      "height": 40,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b4n",
      "roundness": null,
      "seed": 2031137833,
      "version": 81,
      "versionNonce": 1168881475,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1788712852684,
      "link": null,
      "locked": false,
      "text": "5. Segment/range allocation (Leaf-segment) — a node pre-fetches a block of IDs and hands them\nout locally",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "5. Segment/range allocation (Leaf-segment) — a node pre-fetches a block of IDs and hands them out locally",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
