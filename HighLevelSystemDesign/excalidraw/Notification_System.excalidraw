      "text": "Synchronous REST/gRPC — for low-volume, immediate sends (e.g., \"your password was reset\").",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Synchronous REST/gRPC — for low-volume, immediate sends (e.g., \"your password was reset\").",
