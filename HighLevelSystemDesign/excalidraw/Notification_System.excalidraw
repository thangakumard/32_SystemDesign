      "seed": 1364460451,
      "version": 45,
      "versionNonce": 163536579,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788720734734,
      "link": null,
      "locked": false,
      "text": "A single high-volume system account (e.g., an official sports league account with 50M followers)\ntriggers a single event that must fan out to 50M user-partitioned messages. If fan-out happens\nsynchronously inside the producer's request path, one partition's worth of routing logic becomes\na bottleneck.",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A single high-volume system account (e.g., an official sports league account with 50M followers) triggers a single event that must fan out to 50M user-partitioned messages. If fan-out happens synchronously inside the producer's request path, one partition's worth of routing logic becomes a bottleneck.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
