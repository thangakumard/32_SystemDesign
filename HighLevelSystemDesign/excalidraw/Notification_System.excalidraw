    {
      "id": "l5YU_taA2ZajuiAKe_3Ml",
      "type": "text",
      "x": 3288.574760803404,
      "y": 1797.3926582588863,
      "width": 786.3133160600227,
      "height": 260,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b98",
      "roundness": null,
      "seed": 1960670627,
      "version": 58,
      "versionNonce": 1619124013,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788729070082,
      "link": null,
      "locked": false,
      "text": "Problem: a single API call (\"breaking news\") targeting 50M recipients must not synchronously generate 50M\nqueue messages in the producer's request path — this recreates the exact hot-partition and thundering-herd\nproblem the crawler guide addresses via hot-domain sub-queue splitting.\n\nSolution:\n  1. Producer publishes ONE broadcast event (recipient list is implicit — \"all subscribers of topic X\").\n  2. A horizontally-scaled Fan-out Worker tier pulls the subscriber list in paginated batches from the\nsubscription store.\n  3. Each batch is pushed to per-channel queues at a rate-limited pace, bounded by downstream provider\ncapacity — not by how fast the subscriber list can be read.\n\nResult: the API call returns immediately; the fan-out itself is a background, rate-controlled, horizontally-\nscalable job — not arequest-time liability.",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Problem: a single API call (\"breaking news\") targeting 50M recipients must not synchronously generate 50M queue messages in the producer's request path — this recreates the exact hot-partition and thundering-herd problem the crawler guide addresses via hot-domain sub-queue splitting.\n\nSolution:\n  1. Producer publishes ONE broadcast event (recipient list is implicit — \"all subscribers of topic X\").\n  2. A horizontally-scaled Fan-out Worker tier pulls the subscriber list in paginated batches from the subscription store.\n  3. Each batch is pushed to per-channel queues at a rate-limited pace, bounded by downstream provider capacity — not by how fast the subscriber list can be read.\n\nResult: the API call returns immediately; the fan-out itself is a background, rate-controlled, horizontally-scalable job — not arequest-time liability.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
