    {
      "id": "Xvggv73kZ0DfICWh4QDy3",
      "type": "text",
      "x": 3189.683296230467,
      "y": -1992.6963125273496,
      "width": 463.2955322265625,
      "height": 160,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b6W",
      "roundness": null,
      "seed": 2000888813,
      "version": 260,
      "versionNonce": 1808732909,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788715702070,
      "link": null,
      "locked": false,
      "text": "Target: 500M DAU - 5 notifications / user / day \nDaily volumn = 500, 000, 000 * 5 = 2.5 Billion notifications / day\n\n2.5 billion/ 86,400 = 28,900 notifications/ sec\n*8 => peak time = 230,000 notifications / sec\n\n2.5 billion * 500 Bites = 1.25 TB / day\n",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Target: 500M DAU - 5 notifications / user / day \nDaily volumn = 500, 000, 000 * 5 = 2.5 Billion notifications / day\n\n2.5 billion/ 86,400 = 28,900 notifications/ sec\n*8 => peak time = 230,000 notifications / sec\n\n2.5 billion * 500 Bites = 1.25 TB / day\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
