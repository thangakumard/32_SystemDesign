      "isDeleted": false,
      "boundElements": null,
      "updated": 1788719562172,
      "link": null,
      "locked": false,
      "text": "Async event consumption — the gateway itself subscribes to producer-owned Kafka topics (e.g.,\norder_shipped) for high-volume, decoupled use cases.",
